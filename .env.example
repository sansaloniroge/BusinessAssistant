# Postgres bootstrap role (docker-compose) — superuser, solo para migraciones/admin.
# No usar este rol como DATABASE_URL de la app: un superuser ignora RLS siempre.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=businessassistant
POSTGRES_PORT=5432

# Rol de runtime de la app, sin privilegios de superuser/bypassrls (creado por
# alembic/versions/0005_app_runtime_role.py, no por docker-compose directamente).
APP_DB_USER=app_runtime
APP_DB_PASSWORD=app_runtime

# pgAdmin (optional)
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# DSN que usa la app y los scripts (ingesta, eval runner...) — rol de mínimo privilegio.
DATABASE_URL=postgresql://app_runtime:app_runtime@localhost:5432/businessassistant

# DSN que usa Alembic para migraciones (DDL, CREATE ROLE, GRANT...) — rol bootstrap.
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/businessassistant

# OpenAI (embeddings / LLM real — deja vacío para usar los stubs DEV)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

