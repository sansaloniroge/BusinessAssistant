# Postgres (docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=businessassistant
POSTGRES_PORT=5432

# pgAdmin (optional)
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# App DSN (si lo necesitas en la app/tests de integración)
DATABASE_URL=postgresql://app:app@localhost:5432/businessassistant

# OpenAI (embeddings / LLM real — deja vacío para usar los stubs DEV)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

